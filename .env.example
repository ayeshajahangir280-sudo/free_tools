APP_ENV=production
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=https://freetools-hub.pages.dev
MAX_BODY_BYTES=16384
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
# File where contact messages are appended (JSON lines). Must be on persistent storage.
CONTACT_STORE_PATH=data/messages.jsonl
# Optional SMTP forwarding of contact messages (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
